#include <stdio.h>

int queue[20], front = -1, rear = -1;
int visited[20];

void bfs(int graph[20][20], int n, int start)
{
    int i, current;

    front = rear = 0;
    queue[rear] = start;
    visited[start] = 1;

    while (front <= rear)
    {
        current = queue[front++];
        printf("%d ", current);

        for (i = 0; i < n; i++)
        {
            if (graph[current][i] == 1 &&
                visited[i] == 0)
            {
                queue[++rear] = i;
                visited[i] = 1;
            }
        }
    }
}

int main()
{
    int graph[20][20] = {0};
    int n = 5;

    graph[0][1] = graph[1][0] = 1;
    graph[0][2] = graph[2][0] = 1;
    graph[1][3] = graph[3][1] = 1;
    graph[1][4] = graph[4][1] = 1;

    printf("BFS Traversal: ");
    bfs(graph, n, 0);

    return 0;
}
