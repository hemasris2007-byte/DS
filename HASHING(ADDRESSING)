#include <stdio.h>

#define SIZE 10

int hashTable[SIZE];

void insert(int key)
{
    int index = key % SIZE;
    int i = 0;

    while (i < SIZE)
    {
        int pos = (index + i) % SIZE;

        if (hashTable[pos] == -1)
        {
            hashTable[pos] = key;
            return;
        }

        i++;
    }

    printf("Hash table is full. Cannot insert %d\n", key);
}

void display()
{
    int i;

    printf("\nHash Table:\n");

    for (i = 0; i < SIZE; i++)
    {
        printf("%d: ", i);

        if (hashTable[i] == -1)
            printf("EMPTY");
        else
            printf("%d", hashTable[i]);

        printf("\n");
    }
}

int main()
{
    int n, key, i;

    for (i = 0; i < SIZE; i++)
        hashTable[i] = -1;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter the elements:\n");

    for (i = 0; i < n; i++)
    {
        scanf("%d", &key);
        insert(key);
    }

    display();

    return 0;
}
