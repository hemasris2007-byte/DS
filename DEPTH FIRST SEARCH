#include <stdio.h>

int graph[20][20], visited[20], n;

void dfs(int vertex)
{
    int i;

    visited[vertex] = 1;
    printf("%d ", vertex);

    for (i = 0; i < n; i++)
    {
        if (graph[vertex][i] == 1 && visited[i] == 0)
        {
            dfs(i);
        }
    }
}

int main()
{
    int i;

    n = 5;

    for (i = 0; i < n; i++)
        visited[i] = 0;

    graph[0][1] = graph[1][0] = 1;
    graph[0][2] = graph[2][0] = 1;
    graph[1][3] = graph[3][1] = 1;
    graph[1][4] = graph[4][1] = 1;

    printf("DFS Traversal: ");
    dfs(0);

    return 0;
}
